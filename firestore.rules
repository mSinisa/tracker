rules_version = '2';

// Only the allowed users, signed in with Google, may read or write, each only in their own
// folder (users/{uid}/...). Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && userId in ["UBewZkSJljMq5acZykNuCjT2yZa2",  // Sinisa
                      "dR3D6LbGSXex2DQG3weR6gD8tur1"]  // wife
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function validId(id) {
      return id is string && id.matches("^[a-z0-9-]{1,40}$");
    }

    match /users/{userId}/categories/{categoryId} {
      function validCategory() {
        let c = request.resource.data;
        return c.keys().hasOnly(["name", "color", "goal", "createdAt"])
          && validId(categoryId)
          && c.name is string && c.name.size() > 0 && c.name.size() <= 40
          && c.color is string && c.color.size() <= 20
          && c.createdAt is timestamp
          && c.goal.keys().hasOnly(["type", "target"])
          && (c.goal.type == "daily"
              || (c.goal.type in ["perMonth", "perWeek"]
                  && c.goal.target is int && c.goal.target >= 1 && c.goal.target <= 31));
      }
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validCategory();
    }

    match /users/{userId}/entries/{entryId} {
      function validEntry() {
        let e = request.resource.data;
        return e.keys().hasOnly(["categoryId", "date", "checkedInAt", "source"])
          && validId(e.categoryId)
          && e.date is string && e.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && entryId == e.categoryId + "_" + e.date
          && e.checkedInAt is timestamp
          && e.source in ["button", "calendar"];
      }
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validEntry();
    }
  }
}
